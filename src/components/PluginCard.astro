---
const { plugin } = Astro.props;
const { slug, title, description, category, version, date, size_mb } = plugin;
---
<article class="card" data-category={category}>
  <h3><a href={`/plugins/${slug}/`}>{title}</a></h3>
  <p>{description}</p>
  <div class="meta">
    <span class="tag">{category}</span>
    <span>v{version}</span>
    <span>{size_mb} МБ</span>
    <time datetime={date}>{date}</time>
  </div>
</article>
